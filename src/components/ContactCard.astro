---
// ContactCard — the "person you'll actually talk to" card: ONE white rounded
// container holding a portrait nested inside it (a few px of white all around)
// on the left, and the role, the name set big and the credential line on the
// right. Built to sit on a coloured field (the orange CTA band), so the card is
// pure white and the type inside it is ink.
//
// No call to action lives here on purpose: the band this sits in already has
// one, and a second button next to it only splits the click.
import { Image } from 'astro:assets';
import portrait from '@/assets/gerardo.webp';

interface Props {
  /** Job title, set bold on the first line. */
  role?: string;
  /** The quieter second line under the role ("en raız®"). */
  at?: string;
  /** Full name — each word gets its own line, like the reference card. */
  name?: string;
  /** Credential line at the foot of the card. */
  credential?: string;
  class?: string;
}

const {
  role = 'Fundador',
  at = 'en raız®',
  name = 'Gerardo Moreira',
  credential = 'Ingeniero en Sistemas',
  class: className,
} = Astro.props;

const nameLines = name.trim().split(/\s+/);
---

<div class:list={['ccard', className]}>
  <div class="ccard__photo">
    <Image
      src={portrait}
      alt={`${name}, ${role} ${at}`}
      widths={[220, 440, 660]}
      sizes="(min-width: 640px) 200px, 40vw"
      format="webp"
      quality={82}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="ccard__panel">
    <div class="ccard__who">
      <p class="ccard__role">{role}</p>
      <p class="ccard__at">{at}</p>
    </div>

    <h3 class="ccard__name">
      {nameLines.map((word, i) => (
        <>
          {i > 0 && <br />}
          {word}
        </>
      ))}
    </h3>

    <p class="ccard__cred">{credential}</p>
  </div>
</div>

<style>
  /* One white container. The portrait is nested inside it with `--inset` of
     white showing all the way around, so the two halves read as a single card.
     The card is sized to its content — just wide enough for the name and the
     credential — rather than stretched to the column, which left a wedge of
     empty white down the right-hand side. */
  .ccard {
    --inset: 6px;
    --radius-outer: clamp(20px, 2.2vw, 30px);
    display: flex;
    width: 100%;
    max-width: 23rem;
    padding: var(--inset);
    border-radius: var(--radius-outer);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  /* ── Portrait ─────────────────────────────────────────────────── */
  .ccard__photo {
    flex: 0 0 41%;
    /* Concentric with the card: the outer radius less the white inset. */
    border-radius: calc(var(--radius-outer) - var(--inset));
    overflow: hidden;
    background: var(--color-sand);
  }
  .ccard__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%; /* keep the face centred as the card squashes */
  }

  /* ── White panel ──────────────────────────────────────────────── */
  .ccard__panel {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    /* Sits on the shared white; only its own padding separates it from the
       portrait and the card edge. */
    padding: clamp(0.85rem, 1.6vw, 1.15rem) clamp(0.9rem, 1.8vw, 1.25rem)
      clamp(0.85rem, 1.6vw, 1.15rem) clamp(1rem, 2.2vw, 1.5rem);
  }
  .ccard__who {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .ccard__role {
    margin: 0;
    font-size: clamp(0.88rem, 1.1vw, 0.97rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .ccard__at {
    margin: 0;
    font-size: clamp(0.88rem, 1.1vw, 0.97rem);
    color: var(--color-muted);
  }
  .ccard__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  /* Credential — sits where the button used to, anchored to the card's foot
     with a hairline so it reads as a footnote to the name, not as an action. */
  .ccard__cred {
    margin: 0;
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
    font-size: clamp(0.82rem, 1vw, 0.9rem);
    font-weight: 500;
    line-height: 1.3;
    text-wrap: balance;
  }

  /* ── Very narrow phones — stack the portrait above the panel ──── */
  @media (max-width: 335px) {
    .ccard {
      flex-direction: column;
    }
    .ccard__photo {
      flex: 0 0 auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
