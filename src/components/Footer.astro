---
import { nav, whatsappLink, site } from '@/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-24">
  <div class="container py-12 grid gap-8 sm:grid-cols-2">
    <div>
      <p class="font-bold text-lg">{site.name}</p>
      <p class="text-muted text-sm mt-1">{site.tagline}</p>
      <p class="text-muted text-sm mt-3">{site.location}</p>
    </div>

    <div class="flex flex-col gap-2 sm:items-end text-sm">
      {nav.map((item) => (
        <a href={item.href} class="text-muted hover:text-ink transition-colors">
          {item.label}
        </a>
      ))}
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener"
        class="text-muted hover:text-ink transition-colors"
      >
        WhatsApp
      </a>
    </div>
  </div>

  <div class="container pb-8 text-xs text-muted">
    © {year} {site.name}. Hecho en Guanacaste.
  </div>
</footer>
