---
import { nav, whatsappLink, site, social } from '@/site';
import Logo from './Logo.astro';

interface Props {
  /**
   * Colour tone. "default" is the usual grey canvas footer; "accent" continues
   * the home page's orange CTA band to the bottom of the page — the orange runs
   * unbroken from the band into the footer, so the two read as one field.
   * On the orange, every small text runs in ink (6.1:1) rather than white
   * (3.2:1), which only clears the bar at display sizes.
   * "dark" is a deep-black slab — it anchors the all-orange pages (Proyectos),
   * where the orange field above hands off to a black footer at the very bottom.
   */
  tone?: 'default' | 'accent' | 'dark';
}

const { tone = 'default' } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class:list={[
    'site-footer',
    tone === 'accent' && 'site-footer--accent',
    tone === 'dark' && 'site-footer--dark',
  ]}
>
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__mark">
        <Logo class="site-footer__logo" />
        <span>nambuku<span class="site-footer__reg">®</span></span>
      </p>
      <p class="site-footer__sub">{site.tagline}</p>
      <p class="site-footer__sub">{site.location}</p>
    </div>

    <nav class="site-footer__links" aria-label="Pie de página">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={whatsappLink} target="_blank" rel="noopener">WhatsApp</a>
      {social.map((profile) => (
        <a href={profile.href} target="_blank" rel="noopener me">{profile.name}</a>
      ))}
    </nav>
  </div>

  <div class="container site-footer__legal">
    © {year} {site.name}. Hecho en Guanacaste.
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    /* Tone variables — the accent footer only has to swap these. */
    --footer-bg: transparent;
    --footer-strong: var(--color-ink);
    --footer-quiet: var(--color-muted);
    --footer-hover: var(--color-ink);
    --footer-reg: var(--color-accent);
    background: var(--footer-bg);
    color: var(--footer-strong);
  }
  .site-footer__grid {
    display: grid;
    gap: 2rem;
    padding-block: 3rem;
  }
  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .site-footer__mark {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.025em;
    color: var(--footer-strong);
  }
  /* :global() + aspect-ratio: see the same rule in Nav.astro. */
  .site-footer__mark :global(.site-footer__logo) {
    flex: none;
    /* 1.09em of box = 0.95em of ink, since the viewBox is 8 units padded. */
    height: 1.09em;
    width: auto;
    aspect-ratio: 146 / 122;
  }
  .site-footer__reg {
    font-size: 1rem;
    vertical-align: super;
    color: var(--footer-reg);
  }
  .site-footer__sub {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    color: var(--footer-quiet);
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  .site-footer__links a {
    color: var(--footer-quiet);
    transition: color 160ms ease;
  }
  .site-footer__links a:hover {
    color: var(--footer-hover);
  }
  @media (min-width: 640px) {
    .site-footer__links {
      align-items: flex-end;
    }
  }
  .site-footer__legal {
    padding-bottom: 2rem;
    font-size: 0.75rem;
    color: var(--footer-quiet);
  }

  /* ── Accent tone — the tail of the home page's orange band ─────────── */
  .site-footer--accent {
    margin-top: 0; /* no seam: the band's colour simply carries on */
    --footer-bg: var(--color-accent);
    /* Ink, not white: at 14px white-on-orange is 3.2:1 and fails AA, while
       ink-on-orange is 6.1:1. */
    --footer-strong: var(--color-ink);
    --footer-quiet: rgba(10, 10, 10, 0.78);
    --footer-hover: var(--color-ink);
    --footer-reg: #ffffff;
  }
  /* No rule across the top: the band and the footer are one unbroken field. */
  .site-footer--accent .site-footer__grid {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* ── Dark tone — the deep-black slab that anchors the all-orange pages ───
     The orange field runs down to the footer, which lands as a full-bleed
     deep-black block. White text on black is 18:1+, so everything reverses to
     white (quiet text at 60%), and the ® keeps its Kinetic Orange. */
  .site-footer--dark {
    margin-top: clamp(4rem, 8vw, 7rem);
    --footer-bg: var(--color-ink);
    --footer-strong: #ffffff;
    --footer-quiet: rgba(255, 255, 255, 0.6);
    --footer-hover: #ffffff;
    --footer-reg: var(--color-accent);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }
</style>
