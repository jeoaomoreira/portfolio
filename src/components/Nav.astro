---
import { nav, whatsappLink, site } from '@/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

{/* Flat, fabrica-style top bar: wordmark left, links right, burger on mobile.
    Sticky and in normal flow (no floating pill, no scroll-dock). */}
<header class="nav" data-nav>
  <div class="nav__inner container">
    <a href="/" class="nav__brand" aria-label={`${site.name} — inicio`}>
      nambuku<span class="nav__reg">®</span>
    </a>

    <nav class="nav__links" aria-label="Navegación principal">
      {
        nav
          .filter((item) => item.href !== '/')
          .map((item) => (
            <a
              href={item.href}
              class:list={['nav__link', isActive(item.href) && 'is-active']}
            >
              {item.label}
            </a>
          ))
      }
    </nav>

    <button
      class="nav__burger"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

{/* Mobile menu overlay — opened by the burger. */}
<div class="site-menu" id="site-menu" aria-hidden="true">
  <div class="site-menu__panel" data-menu-panel>
    <nav class="site-menu__links" aria-label="Menú">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['site-menu__link', isActive(item.href) && 'is-active']}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href={whatsappLink} target="_blank" rel="noopener" class="btn btn-accent site-menu__cta">
      Hablemos
    </a>
  </div>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-canvas); /* completely solid, no border */
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 64px;
  }

  .nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1;
  }
  .nav__reg {
    font-size: 0.5em;
    font-weight: 600;
    vertical-align: super;
    margin-left: 0.05em;
    color: var(--color-accent);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .nav__link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 160ms ease;
  }
  .nav__link:hover {
    color: var(--color-ink);
  }
  .nav__link.is-active {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* ── Burger (mobile only) ─────────────────────────────────────── */
  .nav__burger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .nav__burger span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 220ms var(--ease-out-strong),
      opacity 160ms ease;
  }
  .nav__burger.is-open span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav__burger.is-open span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ── Mobile overlay menu ──────────────────────────────────────── */
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-canvas) 92%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 240ms var(--ease-out-strong),
      visibility 0s linear 240ms;
  }
  .site-menu.is-open {
    visibility: visible;
    opacity: 1;
    transition: opacity 240ms var(--ease-out-strong);
  }
  .site-menu__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .site-menu__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }
  .site-menu__link {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }
  .site-menu__link.is-active {
    color: var(--color-accent);
  }
  .site-menu__cta {
    margin-top: 0.75rem;
  }

  /* ── Breakpoint ───────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .nav__links {
      display: none;
    }
    .nav__burger {
      display: inline-flex;
    }
  }
  @media (min-width: 769px) {
    .site-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__burger span,
    .site-menu {
      transition:
        opacity 200ms ease,
        transform 200ms ease;
    }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.nav__burger');
  const menu = document.getElementById('site-menu');
  const header = document.querySelector<HTMLElement>('[data-nav]');

  if (burger && menu) {
    const lenis = () => (window as unknown as { lenis?: { stop(): void; start(): void } }).lenis;
    const setOpen = (open: boolean) => {
      header?.classList.toggle('is-menu-open', open);
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      if (open) {
        lenis()?.stop();
        document.documentElement.style.overflow = 'hidden';
      } else {
        lenis()?.start();
        document.documentElement.style.overflow = '';
      }
    };

    let lastFocused: HTMLElement | null = null;
    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href]')).filter(
        (el) => el.offsetParent !== null,
      );

    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0]!;
      const last = items[items.length - 1]!;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    burger.addEventListener('click', () => {
      const opening = !menu.classList.contains('is-open');
      if (opening) lastFocused = document.activeElement as HTMLElement;
      setOpen(opening);
      if (opening) focusables()[0]?.focus();
      else lastFocused?.focus();
    });
    menu
      .querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', () => setOpen(false)));
    menu.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-menu-panel]')) {
        setOpen(false);
        burger.focus();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !menu.classList.contains('is-open')) return;
      setOpen(false);
      burger.focus();
    });
    window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
