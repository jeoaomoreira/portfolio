---
import { nav, whatsappLink, site } from '@/site';
import Logo from '@/components/Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="border-b border-border bg-canvas/80 backdrop-blur sticky top-0 z-40">
  <nav class="container flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 font-display font-semibold text-xl tracking-tight">
      <Logo class="h-7 w-auto text-brand" title={site.name} />
      {site.name}
    </a>

    <ul class="hidden md:flex items-center gap-7 text-sm">
      {
        nav
          .filter((item) => item.href !== '/')
          .map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'transition-colors hover:text-ink',
                  isActive(item.href) ? 'text-ink font-medium' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
      }
    </ul>

    <a href={whatsappLink} target="_blank" rel="noopener" class="btn btn-accent btn-sm">
      Hablemos
    </a>
  </nav>
</header>
