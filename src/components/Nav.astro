---
import { nav, site } from '@/site';
import Logo from './Logo.astro';
import LanguageDropdown from './LanguageDropdown.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

// Desktop top bar: the main links sit in the centre. Inicio is the logo and
// Contacto is the CTA on the right, so both drop out of the centred set.
const centerLinks = nav.filter(
  (item) => !['/', '/contacto'].includes(item.href),
);
// Mobile overlay: the same reach, plus Inicio (there is no logo link to tap in
// the overlay). Contacto is still rendered separately as the CTA.
const menuLinks = nav.filter((item) => item.href !== '/contacto');
---

{/* Flat, fabrica-style top bar: wordmark left, links right, burger on mobile.
    Sticky and in normal flow (no floating pill, no scroll-dock). */}
<header class="nav" data-nav>
  <div class="nav__inner container">
    <a href="/" class="nav__brand" aria-label={`${site.name} — inicio`}>
      <Logo class="nav__logo" />
      <span>nambuku<span class="nav__reg">®</span></span>
    </a>

    <nav class="nav__links" aria-label="Navegación principal">
      {
        centerLinks.map((item) => (
          <a
            href={item.href}
            class:list={['nav__link', isActive(item.href) && 'is-active']}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__end">
      <div class="nav__actions">
        <LanguageDropdown />
        <a href="/contacto" class="btn btn-accent btn-sm nav__cta">Contacto</a>
      </div>

      <button
        class="nav__burger"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

{/* Mobile menu overlay — opened by the burger. */}
<div class="site-menu" id="site-menu" aria-hidden="true">
  <div class="site-menu__panel" data-menu-panel>
    <nav class="site-menu__links" aria-label="Menú">
      {
        menuLinks.map((item) => (
          <a
            href={item.href}
            class:list={['site-menu__link', isActive(item.href) && 'is-active']}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <LanguageDropdown />
    <a href="/contacto" class="btn btn-accent site-menu__cta">Contacto</a>
  </div>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-canvas); /* completely solid, no border */
  }
  /* Three tracks: brand pinned left, links in the true centre, actions right.
     The 1fr side tracks keep the centre column optically centred in the bar. */
  .nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
  }
  .nav__brand {
    justify-self: start;
  }
  .nav__links {
    justify-self: center;
  }
  .nav__end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  /* The Contacto CTA (both the bar pill and the overlay button) overrides the
     accent variant's sweep: instead of turning white on hover it darkens to
     deep black, keeping the white label — the original Uiverse look. */
  .nav__cta,
  .site-menu__cta {
    --btn-sweep: var(--color-ink); /* deep black sweeps in … */
    --btn-sweep-ink: var(--color-on-accent); /* … label stays white */
  }
  .nav__cta {
    /* Compact pill for the bar; sweep hover comes from the shared .btn. */
    font-weight: 600;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1;
  }
  /* The mark is an x-height glyph (no ascender), so it is set a little taller
     than the wordmark's x-height to read as its peer rather than as a letter.
     :global() because the <svg> is Logo.astro's root element and carries that
     component's scope, not this one's — a plain .nav__logo never matches it.
     aspect-ratio because the svg has no intrinsic width to derive from height. */
  .nav__brand :global(.nav__logo) {
    flex: none;
    /* 1.09em of box = 0.95em of ink, since the viewBox is 8 units padded. */
    height: 1.09em;
    width: auto;
    aspect-ratio: 146 / 122;
  }
  .nav__reg {
    font-size: 0.5em;
    font-weight: 600;
    vertical-align: super;
    margin-left: 0.05em;
    color: var(--color-accent);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .nav__link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 160ms ease;
  }
  .nav__link:hover {
    color: var(--color-ink);
  }
  .nav__link.is-active {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* ── Burger (mobile only) ─────────────────────────────────────── */
  .nav__burger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .nav__burger span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 220ms var(--ease-out-strong),
      opacity 160ms ease;
  }
  .nav__burger.is-open span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav__burger.is-open span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ── Mobile overlay menu ──────────────────────────────────────── */
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-canvas) 92%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 240ms var(--ease-out-strong),
      visibility 0s linear 240ms;
  }
  .site-menu.is-open {
    visibility: visible;
    opacity: 1;
    transition: opacity 240ms var(--ease-out-strong);
  }
  .site-menu__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .site-menu__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }
  .site-menu__link {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }
  .site-menu__link.is-active {
    color: var(--color-accent);
  }
  .site-menu__cta {
    margin-top: 0.75rem;
  }

  /* ── Breakpoint ───────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .nav__links,
    .nav__actions {
      display: none;
    }
    .nav__burger {
      display: inline-flex;
    }
  }
  @media (min-width: 769px) {
    .site-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__burger span,
    .site-menu {
      transition:
        opacity 200ms ease,
        transform 200ms ease;
    }
  }

  /* ── Accent chrome — the all-orange page (Proyectos) ──────────────────
     Body carries `chrome-accent`. The bar turns Kinetic Orange so the sticky
     nav melts into the orange field; links run in deep black (ink, 6.1:1) for
     legibility, and the Contacto CTA inverts to a deep-black pill (tying to the
     page's black footer) that sweeps to white on hover. */
  :global(body.chrome-accent) .nav {
    background: var(--color-accent);
  }
  :global(body.chrome-accent) .nav__brand {
    color: var(--color-ink);
  }
  :global(body.chrome-accent) .nav__reg {
    color: #ffffff;
  }
  :global(body.chrome-accent) .nav__link {
    color: rgba(10, 10, 10, 0.68);
  }
  :global(body.chrome-accent) .nav__link:hover,
  :global(body.chrome-accent) .nav__link.is-active {
    color: var(--color-ink);
  }
  :global(body.chrome-accent) .nav__burger {
    color: var(--color-ink);
  }
  :global(body.chrome-accent) .nav__cta,
  :global(body.chrome-accent) .site-menu__cta {
    background: var(--color-ink);
    color: #ffffff;
    --btn-sweep: #ffffff; /* white sweeps in … */
    --btn-sweep-ink: var(--color-ink); /* … label flips to deep black */
  }
  /* Mobile overlay turns orange too, with ink links and a white active mark. */
  :global(body.chrome-accent) .site-menu {
    background: color-mix(in srgb, var(--color-accent) 94%, transparent);
  }
  :global(body.chrome-accent) .site-menu__link {
    color: var(--color-ink);
  }
  :global(body.chrome-accent) .site-menu__link.is-active {
    color: #ffffff;
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.nav__burger');
  const menu = document.getElementById('site-menu');
  const header = document.querySelector<HTMLElement>('[data-nav]');

  if (burger && menu) {
    const lenis = () => (window as unknown as { lenis?: { stop(): void; start(): void } }).lenis;
    const setOpen = (open: boolean) => {
      header?.classList.toggle('is-menu-open', open);
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', String(!open));
      if (open) {
        lenis()?.stop();
        document.documentElement.style.overflow = 'hidden';
      } else {
        lenis()?.start();
        document.documentElement.style.overflow = '';
      }
    };

    let lastFocused: HTMLElement | null = null;
    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button')).filter(
        (el) => el.offsetParent !== null,
      );

    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0]!;
      const last = items[items.length - 1]!;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    burger.addEventListener('click', () => {
      const opening = !menu.classList.contains('is-open');
      if (opening) lastFocused = document.activeElement as HTMLElement;
      setOpen(opening);
      if (opening) focusables()[0]?.focus();
      else lastFocused?.focus();
    });
    menu
      .querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', () => setOpen(false)));
    menu.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-menu-panel]')) {
        setOpen(false);
        burger.focus();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !menu.classList.contains('is-open')) return;
      setOpen(false);
      burger.focus();
    });
    window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
