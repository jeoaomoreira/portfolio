---
import { whatsappLink } from '@/site';
---

<a
  href={whatsappLink}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="wa-fab"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="h-7 w-7"
    aria-hidden="true"
  >
    <path
      d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.82 9.82 0 001.636 5.373l-.999 3.648 3.863-1.013zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
    ></path>
  </svg>
</a>

<style>
  /* Floating WhatsApp action. Sits clear of the iOS home indicator and of the
     browser chrome on Android via the safe-area insets. */
  .wa-fab {
    position: fixed;
    right: calc(1.25rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    width: 3.5rem;
    border-radius: 999px;
    background: var(--color-whatsapp);
    color: #fff;
    box-shadow: 0 10px 24px -8px rgba(31, 26, 23, 0.45);
    transition: transform 160ms var(--ease-out-strong);
  }
  .wa-fab:active {
    transform: scale(0.95);
  }
  @media (hover: hover) and (pointer: fine) {
    .wa-fab:hover {
      transform: scale(1.05);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-fab,
    .wa-fab:active,
    .wa-fab:hover {
      transition: none;
      transform: none;
    }
  }
</style>
