  .hero-work:focus-visible {
    transform: translateY(-2px);
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
  }
  .hero-work:focus-visible .mock-browser {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 34px 70px -32px rgba(31, 26, 23, 0.5);
  }
  .hero-work:focus-visible .hero-work__hint {
    opacity: 1;
    transform: none;
  }

  /* ── Stacked hero (< lg) ────────────────────────────────────────
     One column, so the copy and the mockups share one screen's height. Cap the
     mockup and ease the type down; without this the browser frame overflowed
     the pinned stage on every tablet and large phone. */
  @media (max-width: 1023px) {
    .hero-grid {
      justify-items: center;
      text-align: left;
    }
    .hero-copy {
      max-width: 38rem;
      width: 100%;
    }
    .copy-card--title .hero-title {
      font-size: clamp(1.45rem, 4.2vw, 2rem);
    }
    .hero-sub {
      font-size: 1rem;
      max-width: none;
    }
    .hero-work {
      width: min(100%, 20rem);
      margin-inline: auto;
      padding-bottom: 0.75rem;
    }
  }

  /* ── Phone (≤ sm) ───────────────────────────────────────────────
     The stage is pinned at 100svh with overflow hidden, so everything in the
     hero has to FIT one screen — otherwise the mockups (the whole point of
     this hero) fall off the bottom and are never seen. Measured on 375×667:
     the composition has to come in under ~533px of usable height. */
  @media (max-width: 640px) {
    .rhero {
      --track: 0; /* tighter start so the wordmark fits a phone */
    }
    .rhero__word {
      font-size: 144px; /* scaled so "raíz" fits portrait width */
    }
    .rhero__content {
      align-items: flex-start;
      padding-top: calc(var(--nav-h) + 0.75rem);
      padding-bottom: 1rem;
    }
    .copy-card {
      padding: 1rem 1.15rem;
      border-radius: 26px;
    }
    .copy-card--title {
      grid-template-columns: minmax(54px, 0.3fr) 1fr;
      gap: 0.85rem;
    }
    .copy-card__logo {
      max-width: 62px;
    }
    .copy-card--title .hero-title {
      font-size: 1.45rem;
      line-height: 1.12;
    }
    .copy-card--body {
      padding-bottom: 1.15rem;
    }
    .hero-sub {
      font-size: 0.95rem;
      line-height: 1.45;
    }
    /* Both CTAs share one row so the card doesn't grow a second button line. */
    .hero-cta {
      gap: 0.5rem;
      margin-top: 1rem;
      flex-wrap: nowrap;
    }
    .hero-cta .btn {
      flex: 1 1 0;
      min-width: 0;
      padding-inline: 0.5rem;
      font-size: 0.88rem;
    }
    .hero-copy {
      gap: 0.6rem;
    }
    .hero-grid {
      gap: 1.1rem;
    }
    /* Scale the mockups down so the browser frame lands inside the stage
       instead of being clipped in half. */
    .hero-work {
      width: min(100%, 15rem);
      margin-inline: auto;
      padding-bottom: 1rem;
    }
    .demo-hero {
      padding: 1rem 0.85rem;
    }
    .demo-h {
      font-size: 0.9rem;
    }
    /* Drop the mock's placeholder card row on phones: it costs ~70px and the
       nav + hero band already read as "a real site" at this size. Keeping it
       would mean shrinking the whole mockup until nothing in it is legible. */
    .demo-row {
      display: none;
    }
    .demo-cabina {
      padding-bottom: 0.4rem;
    }
    .hero-work__hint {
      display: none; /* hover-only affordance; no hover on a phone */
    }
    .rhero__intro-title {
      font-size: 2.1rem;
    }
    /* Stack the button above its caption so the row never crowds. */
    .rhero__intro-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }

  /* Short phones (landscape, SE-class): shave the intro so it can't ride over
     the composition. */
  @media (max-width: 640px) and (max-height: 700px) {
    .rhero__intro {
      display: none;
    }
  }

  /* ── Reduced motion: hold a composed, readable state ─────── */
  @media (prefers-reduced-motion: reduce) {
    .rhero {
      --bgScale: 1;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('.rhero');
  if (section) {
    const mm = gsap.matchMedia();

    // Discrete "revealed" state: gate the hero content's pointer-events once the
    // work has played in. (The nav is a separate, site-wide component now.)
    const setRevealed = (on: boolean) => {
      section.classList.toggle('is-revealed', on);
    };

    // Hybrid reveal:
    //   • "raíz" is SCRUBBED — tied to scroll, so the visitor drives its fade
    //     and drift directly. Opacity fades linearly (tracks the scroll 1:1);
    //     the drift/scale keep an ease-out for a settled feel.
    //   • Once "raíz" has been scrubbed fully out, that TRIGGERS the cards +
    //     mockups to play in on their own (self-paced), reversing on scroll-up.
    // Reduced motion skips both and uses the class-based reveal below.
    mm.add(
      {
        desktop: '(min-width: 641px) and (prefers-reduced-motion: no-preference)',
        mobile: '(max-width: 640px) and (prefers-reduced-motion: no-preference)',
      },
      (ctx) => {
        const mobile = ctx.conditions!.mobile;
        const probTitle = section.querySelector('.rhero__problem-title');
        const probItems = section.querySelectorAll('.rhero__problem-item');
        // Scroll distance the visitor scrubs "raíz" over before the cards fire.
        // This is the "trigger later" knob — raise it for more interaction.
        const scrubEnd = mobile ? 300 : 360;

        // "raíz" drift + bg scale — scrubbed, with an ease-out settle.
        gsap.to(section, {
          ease: 'power2.out',
          '--bgScale': 1,
          '--wordY': mobile ? -200 : -320,
          '--track': mobile ? 16 : 66,
          '--fade': -0.4,
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: `top top-=${scrubEnd}`,
            scrub: true,
          },
        });
        // "raíz" fade — scrubbed and LINEAR, so it tracks the scroll evenly and
        // reaches 0 right as the cards get triggered. Its progress ALSO drives
        // the cards' --gate: 1 while "raíz" is gone, ramping to 0 as it returns.
        // Because the gate is scroll-locked to "raíz", the cards' exit can never
        // lag "raíz" on a fast scroll-up (their entrance is still self-played).
        const setGate = (wordOp: number) => {
          const g = Math.min(Math.max(1 - wordOp / 0.2, 0), 1);
          section.style.setProperty('--gate', String(g));
        };
        gsap.to(section, {
          ease: 'none',
          '--wordOp': 0,
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: `top top-=${scrubEnd}`,
            scrub: true,
            onUpdate: (self) => setGate(1 - self.progress), // --wordOp === 1 − progress
            onLeave: () => setGate(0), // past the end → "raíz" gone → gate open
            onLeaveBack: () => setGate(1), // above the start → "raíz" full → gate shut
          },
        });

        // Cards + mockups — a paused timeline that PLAYS ITSELF once "raíz" is
        // gone. It animates the --*Play vars (the entrance); the --gate above
        // then multiplies them for the actual visibility. Cards fade via a
        // mask-alpha (backdrop-filter stays live); mockups via opacity. Staggered.
        const cards = gsap.timeline({
          paused: true,
          defaults: { ease: 'power2.out' },
        });
        cards
          .to(probTitle, { duration: 0.5, '--play': 1, '--riseY': 0 })
          .to(
            probItems,
            { duration: 0.5, '--play': 1, '--riseY': 0, stagger: 0.1 },
            '<0.12',
          );

        // Trigger at the end of "raíz"'s scrub: cross it going down to play the
        // cards in. There's no time-based reverse — the scroll-locked --gate
        // fades them out in step with "raíz" returning, so they never linger.
        ScrollTrigger.create({
          trigger: section,
          start: `top top-=${scrubEnd}`,
          onEnter: () => {
            cards.play();
            setRevealed(true);
          },
          onLeaveBack: () => {
            setRevealed(false);
          },
        });
      },
    );

    // Reduced motion: no timeline. Reveal the composed state instantly via the
    // class (the CSS under prefers-reduced-motion shows the cards and hides
    // "raíz") once the visitor scrolls a little into the hero.
    mm.add('(prefers-reduced-motion: reduce)', () => {
      ScrollTrigger.create({
        trigger: section,
        start: 'top top-=160',
        onEnter: () => setRevealed(true),
        onLeaveBack: () => setRevealed(false),
      });
    });

    // The mask uses the Inter webfont; re-measure once it has painted.
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(() =>
      ScrollTrigger.refresh(),
    );
  }
</script>
