---
// PhoneFrame — an iPhone showing the site THROUGH a mobile browser: a dark status row
// with the dynamic island, an address bar with the domain, then the screenshot
// top-aligned at natural width (the page's top fold) — not stretched to fill the glass.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Domain shown in the address bar. */
  url?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  url,
  widths = [240, 480],
  sizes = '240px',
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<div class:list={['phone', className]}>
  <div class="phone__screen">
    <div class="phone__status" aria-hidden="true">
      <span class="phone__island"></span>
    </div>
    <div class="phone__bar">
      {url && <span class="phone__url">{url}</span>}
    </div>
    <div class="phone__view">
      <Image
        class="phone__img"
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        format="webp"
        quality={80}
        loading={loading}
        decoding="async"
      />
    </div>
  </div>
</div>

<style>
  .phone {
    position: relative;
    /* fills its (page-owned) sizing wrapper — callers set the width there */
    width: 100%;
    max-width: 100%;
    aspect-ratio: 9 / 19.5;
    padding: 4px;
    border-radius: 2.3rem;
    background: linear-gradient(145deg, #4a4b50 0%, #27282b 45%, #35363a 70%, #202023 100%);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.35),
      0 1px 0 rgba(255, 255, 255, 0.12) inset,
      0 42px 70px -38px rgba(20, 14, 10, 0.72);
  }
  .phone::before,
  .phone::after {
    content: '';
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, #2a2b2e, #17181a);
  }
  .phone::before {
    right: -2px;
    top: 30%;
    height: 11%;
  }
  .phone::after {
    left: -2px;
    top: 24%;
    height: 17%;
  }
  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 2rem;
    overflow: hidden;
    background: #0c0c0d;
    display: flex;
    flex-direction: column;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  /* Dark status row carrying the dynamic island. */
  .phone__status {
    flex: none;
    position: relative;
    height: 5.4%;
    min-height: 15px;
    background: #0c0c0d;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .phone__island {
    width: 32%;
    height: 62%;
    min-height: 11px;
    background: #000;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  /* Mobile browser address bar (dark UI). */
  .phone__bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.16rem 0.5rem 0.3rem;
    background: #1c1c1f;
  }
  .phone__url {
    max-width: 88%;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    color: #c9c7c4;
    background: #303033;
    border-radius: 999px;
    padding: 0.16rem 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }
  .phone__view {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: #ffffff;
  }
  .phone__img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
