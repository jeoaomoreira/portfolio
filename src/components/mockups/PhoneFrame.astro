---
// PhoneFrame — an iPhone showing the site THROUGH a mobile browser: a dark status row
// with the dynamic island, an address bar with the domain, then the screenshot
// top-aligned at natural width (the page's top fold) — not stretched to fill the glass.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Domain shown in the address bar. */
  url?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  url,
  widths = [240, 480],
  sizes = '240px',
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<div class:list={['phone-fit', className]}>
  <div class="phone">
    <div class="phone__screen">
      <div class="phone__status" aria-hidden="true">
        <span class="phone__island"></span>
      </div>
      <div class="phone__bar">
        {url && <span class="phone__url">{url}</span>}
      </div>
      <div class="phone__view">
        <Image
          class="phone__img"
          src={src}
          alt={alt}
          widths={widths}
          sizes={sizes}
          format="webp"
          quality={80}
          loading={loading}
          decoding="async"
        />
      </div>
    </div>
  </div>
</div>

<style>
  /* Sizing wrapper: callers set the width here. It's the container-query context,
     so every dimension below (in cqw = % of the phone's own width) scales as one
     unit — the frame keeps identical proportions, corner radius and chrome at any
     size, whether it's the big hero phone or a tiny one in the cluster. */
  .phone-fit {
    width: 100%;
    max-width: 100%;
    container-type: inline-size;
  }
  .phone {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 19.5;
    padding: 2.2cqw;
    border-radius: 13cqw;
    background: linear-gradient(145deg, #4a4b50 0%, #27282b 45%, #35363a 70%, #202023 100%);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.35),
      0 1px 0 rgba(255, 255, 255, 0.12) inset,
      0 42px 70px -38px rgba(20, 14, 10, 0.72);
  }
  .phone::before,
  .phone::after {
    content: '';
    position: absolute;
    width: 1.7cqw;
    border-radius: 1cqw;
    background: linear-gradient(180deg, #2a2b2e, #17181a);
  }
  .phone::before {
    right: -1cqw;
    top: 30%;
    height: 11%;
  }
  .phone::after {
    left: -1cqw;
    top: 24%;
    height: 17%;
  }
  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 11cqw;
    overflow: hidden;
    background: #0c0c0d;
    display: flex;
    flex-direction: column;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  /* Dark status row carrying the dynamic island. */
  .phone__status {
    flex: none;
    position: relative;
    height: 5.4%;
    background: #0c0c0d;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .phone__island {
    width: 32%;
    height: 62%;
    background: #000;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  /* Mobile browser address bar (dark UI). */
  .phone__bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.4cqw 4.4cqw 2.6cqw;
    background: #1c1c1f;
  }
  .phone__url {
    max-width: 88%;
    font-family: var(--font-mono);
    font-size: 4.6cqw;
    line-height: 1.2;
    color: #c9c7c4;
    background: #303033;
    border-radius: 999px;
    padding: 1.4cqw 3.3cqw;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }
  .phone__view {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: #ffffff;
  }
  .phone__img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
