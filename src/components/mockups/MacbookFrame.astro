---
// MacbookFrame — a MacBook showing the site THROUGH a desktop browser: traffic-light
// dots + an address bar, then the screenshot top-aligned at natural width (the page's
// top fold, cropped at the bottom like a real window) — not stretched to fill the glass.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Domain shown in the address bar. */
  url?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  url,
  widths = [640, 800],
  sizes = '(min-width: 1024px) 600px, 88vw',
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<div class:list={['mac', className]}>
  <div class="mac__screen">
    <div class="mac__browser">
      <div class="mac__bar">
        <span class="mac__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        {url && <span class="mac__url">{url}</span>}
      </div>
      <div class="mac__view">
        <Image
          class="mac__img"
          src={src}
          alt={alt}
          widths={widths}
          sizes={sizes}
          format="webp"
          quality={82}
          loading={loading}
          decoding="async"
        />
      </div>
    </div>
  </div>
  <div class="mac__base" aria-hidden="true">
    <span class="mac__lip"></span>
  </div>
</div>

<style>
  .mac {
    width: 100%;
    filter: drop-shadow(0 40px 56px rgba(31, 26, 23, 0.26));
  }
  /* Thin black bezel around the browser window. */
  .mac__screen {
    background: #0b0b0d;
    border-radius: 14px 14px 5px 5px;
    padding: 9px;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 0 0 2px #050506;
  }
  .mac__browser {
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    background: #ffffff;
    display: flex;
    flex-direction: column;
  }
  .mac__bar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 9%;
    min-height: 22px;
    padding: 0 0.7rem;
    background: #edebe6;
    border-bottom: 1px solid #dcd7cf;
  }
  .mac__dots {
    display: inline-flex;
    gap: 0.28rem;
    flex: none;
  }
  .mac__dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #d9ccba;
  }
  .mac__dots i:nth-child(1) {
    background: #ff5f57;
  }
  .mac__dots i:nth-child(2) {
    background: #febc2e;
  }
  .mac__dots i:nth-child(3) {
    background: #28c840;
  }
  .mac__url {
    flex: 1;
    max-width: 62%;
    margin-inline: auto;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-muted);
    background: #ffffff;
    border: 1px solid #dcd7cf;
    border-radius: 999px;
    padding: 0.14rem 0.7rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Content viewport: shows the top of the page; the bottom is simply clipped. */
  .mac__view {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: #ffffff;
  }
  .mac__img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Silver base, wider than the screen, with the thumb-lip groove. */
  .mac__base {
    position: relative;
    width: 113%;
    margin-left: -6.5%;
    height: 15px;
    background: linear-gradient(180deg, #e9ebee 0%, #c6cacf 55%, #aeb3ba 100%);
    border-radius: 0 0 11px 11px;
    box-shadow:
      inset 0 2px 1px rgba(255, 255, 255, 0.65),
      inset 0 -2px 2px rgba(120, 124, 130, 0.5);
  }
  .mac__lip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 13%;
    height: 7px;
    background: linear-gradient(180deg, #a9adb4, #ccd0d5);
    border-radius: 0 0 8px 8px;
  }
  @media (min-width: 640px) {
    .mac__base {
      height: 18px;
    }
    .mac__bar {
      min-height: 26px;
    }
  }
</style>
