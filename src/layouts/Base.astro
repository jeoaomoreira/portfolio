---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { site } from '@/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Hide the global nav entirely (rare). */
  hideNav?: boolean;
  /**
   * The page opens with a full-bleed hero behind the nav (the home page). The
   * floating pill starts transparent over it and turns solid on scroll. Interior
   * pages leave this false and get a solid pill with top spacing for the content.
   */
  overHero?: boolean;
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  noindex = false,
  hideNav = false,
  overHero = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph — link previews on Facebook / WhatsApp */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[overHero && 'has-fixed-hero']}>
    {!hideNav && <Nav overHero={overHero} />}
    <main class:list={[!hideNav && !overHero && 'has-fixed-nav']}>
      <slot />
    </main>
    <Footer />
    {/* WhatsApp floating button hidden for now. */}
    {/* <WhatsAppButton /> */}

    <script>
      // Lenis smooth scrolling — site-wide. Skipped entirely for visitors who
      // prefer reduced motion (they keep native scroll). Driven by GSAP's ticker
      // so there is a single rAF loop and future ScrollTriggers stay in sync.
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.05, // modest — close to native, not floaty
          anchors: true, // smooth in-page anchor links (nav/footer jumps)
        });

        // Expose it so the nav can pause scrolling behind its mobile overlay.
        (window as unknown as { lenis?: typeof lenis }).lenis = lenis;

        // Keep ScrollTrigger scrubbing in sync with Lenis's smooth scroll.
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000)); // seconds → ms
        gsap.ticker.lagSmoothing(0);
      }
    </script>
  </body>
</html>
