---
import Base from '@/layouts/Base.astro';
import { whatsappLink, site, social } from '@/site';
---

<Base
  title="Contacto"
  description="Escríbenos por WhatsApp y conversemos sobre el sitio web de tu negocio."
>
  <section class="container section max-w-xl">
    <h1 class="page-title">Hablemos<span class="text-accent">.</span></h1>
    <p class="text-muted mt-5 text-lg">
      La forma más rápida es por WhatsApp. Conversamos sin compromiso sobre lo
      que tu negocio necesita.
    </p>

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener"
      class="btn btn-whatsapp mt-8"
    >
      Escribir por WhatsApp
    </a>

    <div class="mt-10 text-sm text-muted space-y-1">
      <p>Correo: <a href={`mailto:${site.email}`} class="underline hover:text-ink">{site.email}</a></p>
      <p>{site.location}</p>
    </div>

    <div class="mt-8">
      <p class="text-sm text-muted">Seguinos</p>
      <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {social.map((profile) => (
          <li>
            <a
              href={profile.href}
              target="_blank"
              rel="noopener me"
              class="text-muted underline hover:text-ink"
            >
              {profile.name} · {profile.handle}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="text-muted mt-10 text-sm font-mono">[Formulario de contacto · mapa · perfil de Google]</p>
  </section>
</Base>
