---
import Base from '@/layouts/Base.astro';
import { whatsappLink, site } from '@/site';
---

<Base
  title="Contacto"
  description="Escríbenos por WhatsApp y conversemos sobre el sitio web de tu negocio."
>
  <section class="container section max-w-xl">
    <h1 class="page-title">Hablemos</h1>
    <p class="text-muted mt-3">
      La forma más rápida es por WhatsApp. Conversamos sin compromiso sobre lo
      que tu negocio necesita.
    </p>

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener"
      class="btn btn-whatsapp mt-8"
    >
      Escribir por WhatsApp
    </a>

    <div class="mt-10 text-sm text-muted space-y-1">
      <p>Correo: <a href={`mailto:${site.email}`} class="underline hover:text-ink">{site.email}</a></p>
      <p>{site.location}</p>
    </div>

    <p class="text-muted mt-10 text-sm font-mono">[Formulario de contacto · mapa · perfil de Google]</p>
  </section>
</Base>
