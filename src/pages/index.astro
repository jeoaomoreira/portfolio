---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import HeroRaiz from '@/components/HeroRaiz.astro';
import Icon from '@/components/Icon.astro';
import { whatsappLink, offers } from '@/site';
import { projects } from '@/projects';

// Home page — section order per docs/company/website-architecture.md §4.
// NOTE: `cases` and `proofSectors` below are PLACEHOLDERS marked for replacement
// with Gerardo's real clients/projects before this page goes public.
// `offers` comes from src/site.ts so /servicios can never drift out of sync
// with this page.
//
// HERO (Direction: "the work is the hero", per design-taste-frontend / service kind):
// the two device mockups are STAND-INS for real client sites — swap them for real
// screenshots of Gerardo's projects before launch. Demo businesses are illustrative.

const proofSectors = ['Sodas', 'Hoteles & cabinas', 'Tours', 'Salones', 'Talleres', 'Tiendas'];

// The way we work — the three traits behind "El partner que te mereces".
const pillars = [
  {
    n: '01',
    title: 'Curiosidad para entender.',
    body: 'Preguntamos, investigamos y aprendemos antes de recomendar. Tu contexto importa más que una receta.',
  },
  {
    n: '02',
    title: 'Ingenio para avanzar.',
    body: 'Buscamos soluciones prácticas y costo-eficientes. La tecnología tiene que tener sentido para tu negocio.',
  },
  {
    n: '03',
    title: 'Compromiso para acompañar.',
    body: 'Trabajamos con visión de largo plazo, trato cercano y disposición para resolver, no solo para entregar.',
  },
];

const whys = [
  {
    title: 'Raíces locales',
    body: 'Somos de aquí. Te damos la mano en persona, no desde una oficina lejana.',
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    title: 'Oficio moderno',
    body: 'La calidad de diseño de un estudio de ciudad grande, para tu negocio local.',
    icon: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>',
  },
  {
    title: 'Acompañamiento',
    body: 'No construimos y nos vamos. Nos quedamos cuidando tu presencia en el tiempo.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>',
  },
];
---

<Base overHero>
  <HeroRaiz />

  {/* Everything below the hero rides in one opaque layer that scrolls up over the
      now-fixed hero image, fully covering it. */}
  <div class="scroll-over">
    {/* 2. SOCIAL PROOF (placeholder sectors — swap for real client logos) */}
    <section class="border-y border-border bg-sand/60">
      <div class="container py-8">
        <p class="text-sm text-muted text-center">
          Negocios de Guanacaste que crecen con una presencia digital hecha con raíz
        </p>
        <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3 mt-4 text-ink/70 font-medium">
          {proofSectors.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    {/* 2.5 EL PARTNER QUE TE MERECES — how we work, before the proof. */}
    <section class="container section section-divided">
      <div>
        <p class="text-sm font-medium text-accent uppercase tracking-wide">El partner que te mereces</p>
        <h2 class="mt-4 max-w-2xl text-[clamp(2.5rem,5.5vw,4rem)] font-semibold leading-[1.02] tracking-[-0.025em]">
          Que alguien entienda tu negocio cambia todo.
        </h2>
      </div>

      <div class="grid gap-x-8 gap-y-10 sm:grid-cols-3 mt-14">
        {
          pillars.map((p) => (
            <div class="border-t border-border pt-5">
              <span class="font-display text-sm font-semibold text-accent">{p.n}</span>
              <h3 class="text-xl mt-4">{p.title}</h3>
              <p class="text-muted mt-3">{p.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* 3. CASOS DESTACADOS (the sales engine — each card links to its detail page) */}
    <section class="container section section-divided">
      <div class="flex items-end justify-between gap-4 flex-wrap">
        <div>
          <p class="kicker">Proyectos</p>
          <h2 class="section-title mt-1">Negocios que ya dieron el paso</h2>
        </div>
        <a href="/proyectos" class="text-brand font-medium hover:text-brand-strong transition-colors">
          Ver todos →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-10">
        {
          projects.map((p) => (
            <a href={`/proyectos/${p.slug}`} class="card card-surface block overflow-hidden group">
              <div class="aspect-[4/3] bg-sand overflow-hidden">
                <Image
                  src={p.cover}
                  alt={p.coverAlt}
                  widths={[400, 600, 800]}
                  sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                  format="webp"
                  quality={72}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
              <div class="p-5">
                <p class="text-xs uppercase tracking-wide text-brand font-medium">{p.sector}</p>
                <h3 class="text-lg mt-1">{p.name}</h3>
                <p class="text-muted text-sm mt-1">{p.summary}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    {/* 5. QUÉ HACEMOS */}
    <section class="container section section-divided">
      <h2 class="section-title">Todo lo que tu negocio necesita en línea</h2>
      <div class="grid gap-6 sm:grid-cols-3 mt-10">
        {
          offers.map((o) => (
            <div class="card card-surface p-6">
              <h3 class="text-xl">{o.name}</h3>
              <p class="text-muted mt-2 text-sm">{o.desc}</p>
            </div>
          ))
        }
      </div>
      <a
        href="/servicios"
        class="inline-block mt-8 text-brand font-medium hover:text-brand-strong transition-colors"
      >
        Ver servicios y planes →
      </a>
    </section>

    {/* 7. POR QUÉ RAÍZ */}
    <section class="container section section-divided">
      <h2 class="section-title">Por qué Raíz</h2>
      <div class="grid gap-8 sm:grid-cols-3 mt-12">
        {
          whys.map((w) => (
            <div>
              <div class="flex items-center justify-center h-11 w-11 rounded-xl bg-brand/10 text-brand">
                <Icon paths={w.icon} />
              </div>
              <h3 class="text-xl mt-4">{w.title}</h3>
              <p class="text-muted mt-2">{w.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* 8. CTA FINAL */}
    <section class="container pb-24">
      <div class="rounded-[var(--radius)] bg-brand text-on-brand px-6 py-14 sm:px-12 sm:py-20 text-center">
        <h2 class="section-title max-w-2xl mx-auto text-white">
          ¿Listo para que te encuentren y te elijan?
        </h2>
        <p class="mt-4 text-white/80 max-w-lg mx-auto">
          Conversemos sin compromiso sobre la presencia digital de tu negocio.
        </p>
        <a href={whatsappLink} target="_blank" rel="noopener" class="btn btn-accent mt-8">
          Hablemos por WhatsApp
        </a>
      </div>
    </section>
  </div>
</Base>
