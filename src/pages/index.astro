         a breather between the deep-black "Por qué" section and the orange CTA
         band. No-JS and keyboard-accessible by construction; the +/− is the only
         motion and it respects reduced-motion. */}
    <section class="section faq-section">
      <div class="container">
        <div class="faq__head">
          <p class="kicker">Preguntas frecuentes</p>
          <h2 class="faq__title">Hablemos claro<span class="text-accent">.</span></h2>
        </div>

        <div class="faq__list">
          {
            faqs.map((f) => (
              <details class="faq__item">
                <summary class="faq__q">
                  <span>{f.q}</span>
                  <span class="faq__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <path d="M5 12h14" />
                      <path class="faq__icon-v" d="M12 5v14" />
                    </svg>
                  </span>
                </summary>
                <div class="faq__a">
                  <p>{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* 8. CTA FINAL — full-bleed Kinetic Orange band that runs into the footer.
         Same edge-to-edge treatment as the Proyectos section, inverted: orange
         field, white display type, white button, white contact card. */}
    <section class="section cta-band">
      <div class="container">
        <h2 class="cta-band__title">¿Listo para que te encuentren y te elijan?</h2>

        <div class="cta-band__foot">
          <div class="cta-band__copy">
            <p class="cta-band__lead">
              Conversemos sin compromiso sobre la presencia digital de tu negocio.
            </p>
            <a href={whatsappLink} target="_blank" rel="noopener" class="cta-band__btn">
              Hablemos por WhatsApp
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
          </div>

          <ContactCard class="cta-band__card" />
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* "How we work" steps — big thin numerals, two-tone uppercase headings and a
     small tracked description, alternating side to side (reference-driven). */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) 1.15fr;
    align-items: center;
    gap: clamp(1rem, 4vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 3.25rem) clamp(1.75rem, 4vw, 3.5rem);
    border-radius: clamp(26px, 3vw, 44px);
    overflow: hidden;
    /* Per-card colour scheme (defaults; overridden by the three palette cards). */
    --step-fg: var(--color-ink);
    --step-dim: var(--color-muted);
    background: var(--step-bg, var(--color-surface));
  }
  /* The three palette colours: orange, deep black, neutral grey. */
  .step:nth-child(1) {
    --step-bg: var(--color-accent); /* Kinetic Orange */
    --step-fg: var(--color-ink); /* deep black text */
    --step-dim: rgba(10, 10, 10, 0.75);
  }
  .step:nth-child(2) {
    --step-bg: var(--color-ink); /* Deep Black */
    --step-fg: #ffffff; /* white text */
    --step-dim: rgba(255, 255, 255, 0.66);
  }
  .step:nth-child(3) {
    --step-bg: var(--color-grey); /* Neutral Grey */
    --step-fg: var(--color-ink); /* black reads best on the mid-grey */
    --step-dim: rgba(10, 10, 10, 0.68);
  }
  /* Alternate: even steps put the giant numeral on the right. */
  .step:nth-child(even) {
    grid-template-columns: 1.15fr minmax(0, 0.95fr);
  }
  .step:nth-child(even) .step__num {
    order: 2;
    text-align: right;
  }
  .step:nth-child(even) .step__body {
    order: 1;
  }

  .step__num {
    font-family: var(--font-display);
    font-weight: 300; /* thin, like the reference */
    font-size: clamp(6rem, 17vw, 15rem);
    line-height: 0.78;
    letter-spacing: -0.05em;
    color: var(--step-fg);
  }

  .step__meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--step-dim);
  }
  .step__meta-line {
    width: clamp(1.5rem, 4vw, 3rem);
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }
  .step__title {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--step-fg);
  }
  .step__title strong {
    font-weight: 700;
  }
  .step__desc {
    margin: 1.1rem 0 0;
    max-width: 38ch;
    font-size: 0.78rem;
    line-height: 1.7;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--step-dim);
  }
  .step__arrow {
    position: absolute;
    top: clamp(1.5rem, 3vw, 2.5rem);
    right: clamp(1.5rem, 3vw, 2.5rem);
    width: clamp(1.75rem, 3vw, 2.5rem);
    height: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--step-dim);
  }
  .step:nth-child(even) .step__arrow {
    right: auto;
    left: clamp(1.5rem, 3vw, 2.5rem);
    transform: scaleX(-1);
  }

  /* Phone/tablet: stack the number above the text, full width. */
  @media (max-width: 768px) {
    .step,
    .step:nth-child(even) {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .step:nth-child(even) .step__num,
    .step:nth-child(even) .step__body {
      order: 0;
      text-align: left;
    }
    .step__num {
      font-size: clamp(5rem, 30vw, 9rem);
    }
    .step__arrow {
      display: none;
    }
  }

  /* ── Proyectos bento — deep-black panel with varied cells ───────────── */
  /* Full-bleed deep-black section (edge to edge, not a card). */
  .bento-section {
    background: var(--color-ink);
  }
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    color: #fff;
  }
  @media (min-width: 560px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .bento__head,
    .bento__feat,
    .bento__ph--wide,
    .bento__cta {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: minmax(150px, auto);
      grid-template-areas:
        "head head feat feat"
        "p2   p3   feat feat"
        "p4   p4   cta  cta";
    }
    .bento__head { grid-area: head; }
    .bento__feat { grid-area: feat; }
    .bento__ph--02 { grid-area: p2; }
    .bento__ph--03 { grid-area: p3; }
    .bento__ph--wide { grid-area: p4; }
    .bento__cta { grid-area: cta; }
  }

  .bento__cell {
    position: relative;
    display: flex;
    min-height: 185px;
    border-radius: clamp(16px, 1.6vw, 24px);
    background: #16191f; /* dark card lifted off pure black */
    overflow: hidden;
    transition: background-color 200ms ease;
  }

  /* Headline cell — text directly on the black panel (no card). */
  .bento__head {
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 1.8vw, 1.75rem);
  }
  .bento__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0;
    color: #fff;
  }
  .bento__lead {
    margin: 1rem 0 0;
    max-width: 32ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.58);
  }
  .bento__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
    font-weight: 500;
    color: #fff;
  }
  .bento__all svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 200ms var(--ease-out-strong);
  }
  .bento__all:hover svg {
    transform: translateX(3px);
  }

  /* Featured project — full-bleed image + overlay. */
  .bento__feat {
    flex-direction: column;
    justify-content: flex-end;
    min-height: 320px;
  }
  .bento__feat-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out-strong);
  }
  .bento__feat::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 9, 11, 0.92) 0%,
      rgba(8, 9, 11, 0.35) 42%,
      transparent 68%
    );
  }
  .bento__feat:hover .bento__feat-img {
    transform: scale(1.04);
  }
  .bento__feat-info {
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }
  .bento__feat-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    letter-spacing: -0.015em;
    margin: 0.6rem 0 0;
    color: #fff;
  }
  .bento__feat-sum {
    margin: 0.4rem 0 0;
    max-width: 40ch;
