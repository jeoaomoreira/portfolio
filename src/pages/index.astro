    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  /* White pill on the orange — ink label, maximum contrast. */
  .cta-band__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.75rem;
    min-height: 48px;
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 1rem;
    transition:
      background-color 180ms ease,
      transform 160ms var(--ease-out-strong);
  }
  .cta-band__btn:hover {
    background: var(--color-ink);
    color: #fff;
  }
  .cta-band__btn:active {
    transform: scale(0.97);
  }
  .cta-band__btn svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 200ms var(--ease-out-strong);
  }
  .cta-band__btn:hover svg {
    transform: translateX(3px);
  }
  .cta-band__card {
    flex: 0 1 23rem;
  }

  @media (max-width: 900px) {
    .cta-band__foot {
      align-items: flex-start;
    }
    .cta-band__card {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-band__btn,
    .cta-band__btn svg {
      transition: background-color 180ms ease;
    }
    .cta-band__btn:active {
      transform: none;
    }
    .cta-band__btn:hover svg {
      transform: none;
    }
  }
</style>

<script>
  // Oficio moderno — drop the tech tiles in like blocks and let them settle.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mid = document.querySelector<HTMLElement>('.why__item--mid');
  const tiles = gsap.utils.toArray<HTMLElement>('.why__item--mid .tech__inner');

  if (mid && tiles.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const START = 0.82; // the trigger line, as a fraction of the viewport

    const drop = () => {
      tiles.forEach((el, i) => {
        const r = parseFloat(el.dataset.r || '0');
        gsap.fromTo(
          el,
          { yPercent: -460, rotation: 0, opacity: 0 },
          {
            yPercent: 0,
            rotation: r,
            opacity: 1,
            duration: 0.9,
            ease: 'bounce.out',
            delay: i * 0.055,
          },
        );
      });
    };

    // Only hide the tiles if the drop can still be seen. The card used to come
    // back as an empty white box after the phone slept or was rotated: the
    // tiles were hidden the moment the script ran, and if the page then came
    // back already scrolled onto this section, the scroll trigger had no edge
    // left to cross and never revealed them. Hiding only what is still below
    // the trigger line makes "visible" the resting state, so a trigger that
    // never fires costs the animation, not the content.
    if (mid.getBoundingClientRect().top > window.innerHeight * START) {
      gsap.set(tiles, { opacity: 0 });
      ScrollTrigger.create({
        trigger: mid,
        start: `top ${START * 100}%`,
        once: true,
        onEnter: drop,
        // Last line of defence: if a refresh (rotation, bfcache restore) ever
        // leaves the trigger behind us without onEnter having run, show them.
        onRefresh: (self) => {
          if (self.progress > 0 && gsap.getProperty(tiles[0]!, 'opacity') === 0) drop();
        },
      });
    }
  }
</script>
