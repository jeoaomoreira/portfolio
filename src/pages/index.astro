                          />
                          <path class="map-route" d="M 107.3 102.1 L 141.9 66 M 107.3 102.1 L 114.3 160.2" />
                          <circle class="map-town" cx="141.9" cy="66" r="3.2" />
                          <circle class="map-town" cx="151.8" cy="117.7" r="3" />
                          <circle class="map-town" cx="114.3" cy="160.2" r="2.6" />
                          <circle class="map-ring" cx="107.3" cy="102.1" r="14" opacity="0.5" />
                          <circle class="map-ring" cx="107.3" cy="102.1" r="24" opacity="0.3" />
                          <circle class="map-ring" cx="107.3" cy="102.1" r="34" opacity="0.16" />
                          <path
                            class="map-pin"
                            d="M 107.3 66.1 C 115.3 66.1 121.3 72.1 121.3 80.1 C 121.3 91.1 107.3 102.1 107.3 102.1 C 107.3 102.1 93.3 91.1 93.3 80.1 C 93.3 72.1 99.3 66.1 107.3 66.1 Z"
                          />
                          <circle class="map-pin-dot" cx="107.3" cy="79.1" r="4.6" />
                        </svg>
                      ) : i === 1 ? (
                        <div class="tech-pile" aria-hidden="true">
                          {
                            techTiles.map((t, idx) => (
                              <div class="tech" style={`left:${techLayout[idx].x}%;top:${techLayout[idx].y}%`}>
                                <div
                                  class="tech__inner"
                                  data-r={String(techLayout[idx].r)}
                                  style={`--r:${techLayout[idx].r}deg`}
                                >
                                  {t.kind === 'icon' ? (
                                    <svg viewBox="0 0 24 24" fill={`#${t.hex}`}>
                                      <path d={t.path} />
                                    </svg>
                                  ) : (
                                    <span class="tech__mono" style={`color:#${t.hex}`}>
                                      {t.text}
                                    </span>
                                  )}
                                </div>
                              </div>
                            ))
                          }
                        </div>
                      ) : i === 2 ? (
                        <svg
                          class="mon"
                          viewBox="0 0 240 192"
                          preserveAspectRatio="xMidYMid meet"
                          aria-hidden="true"
                        >
                          <defs>
                            <pattern id="monDots" width="13" height="13" patternUnits="userSpaceOnUse">
                              <circle cx="1.5" cy="1.5" r="1.1" class="mon-dotbg" />
                            </pattern>
                            <linearGradient id="monFill" x1="0" y1="0" x2="0" y2="1">
                              <stop offset="0" class="mon-stop0" />
                              <stop offset="1" class="mon-stop1" />
                            </linearGradient>
                          </defs>
                          <rect width="240" height="192" fill="url(#monDots)" />
                          <line class="mon-grid" x1="20" y1="52" x2="220" y2="52" />
                          <line class="mon-grid" x1="20" y1="86" x2="220" y2="86" />
                          <line class="mon-grid" x1="20" y1="120" x2="220" y2="120" />
                          <path class="mon-area" d="M24 110 L52 100 L80 106 L108 86 L136 78 L164 64 L192 54 L214 46 L214 120 L24 120 Z" />
                          <path class="mon-line" d="M24 110 L52 100 L80 106 L108 86 L136 78 L164 64 L192 54 L214 46" />
