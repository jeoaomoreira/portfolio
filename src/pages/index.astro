---
import Base from '@/layouts/Base.astro';
import { whatsappLink } from '@/site';

// Home page — section order per docs/company/website-architecture.md §4.
// NOTE: `cases` and `proofSectors` below are PLACEHOLDERS marked for replacement
// with Gerardo's real clients/projects before this page goes public.

const proofSectors = ['Sodas', 'Hoteles & cabinas', 'Tours', 'Salones', 'Talleres', 'Tiendas'];

const pains = [
  {
    title: 'Invisible en Google',
    body: 'Cuando alguien busca lo que ofrecés, aparecen otros negocios. No el tuyo.',
    icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  },
  {
    title: 'Una página que no te representa',
    body: 'O no tenés sitio web, o el que tenés se ve viejo y te da pena compartirlo.',
    icon: '<rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>',
  },
  {
    title: 'Perdés clientes sin darte cuenta',
    body: 'Negocios con peor servicio, pero mejor presencia, se llevan a tus clientes.',
    icon: '<polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/>',
  },
];

// PLACEHOLDER case studies — replace with real projects.
const cases = [
  { sector: 'Soda', title: 'Caso de ejemplo', result: 'Más reservas por WhatsApp cada semana.' },
  { sector: 'Hotel', title: 'Caso de ejemplo', result: 'Primero en Google para su zona.' },
  { sector: 'Tour', title: 'Caso de ejemplo', result: 'Una página que por fin da confianza.' },
];

const offers = [
  { name: 'Lanzamiento', desc: 'Sitio web nuevo y moderno + tu perfil de Google Business.' },
  { name: 'Renovación', desc: 'Rediseño y mejora del sitio que ya tenés.' },
  { name: 'Plan Raíz', desc: 'Hospedaje, mantenimiento, cambios y soporte — todos los meses.' },
];

const steps = [
  { n: '01', title: 'Conversamos', body: 'Entendemos tu negocio y qué necesitás, en palabras simples.' },
  { n: '02', title: 'Creamos', body: 'Diseñamos y lanzamos tu sitio, y te ponemos en Google.' },
  { n: '03', title: 'Cuidamos', body: 'Lo mantenemos al día con el Plan Raíz. No desaparecemos.' },
];

const whys = [
  {
    title: 'Raíces locales',
    body: 'Somos de aquí. Te damos la mano en persona, no desde una oficina lejana.',
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    title: 'Oficio moderno',
    body: 'La calidad de diseño de un estudio de ciudad grande, para tu negocio local.',
    icon: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>',
  },
  {
    title: 'Acompañamiento',
    body: 'No construimos y nos vamos. Nos quedamos cuidando tu presencia en el tiempo.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>',
  },
];
---

<Base>
  {/* 1. HERO */}
  <section class="container pt-20 pb-16 sm:pt-28 sm:pb-24">
    <p class="text-brand font-medium mb-4">Estudio web · Guanacaste</p>
    <h1 class="text-4xl sm:text-6xl font-semibold tracking-tight max-w-3xl leading-[1.05]">
      Que tu negocio se vea tan bien en internet como lo es en persona.
    </h1>
    <p class="text-muted text-lg mt-6 max-w-xl">
      Sitios web modernos, presencia en Google y mantenimiento continuo — para
      negocios locales de Guanacaste.
    </p>
    <div class="flex flex-wrap gap-3 mt-8">
      <a href={whatsappLink} target="_blank" rel="noopener" class="btn btn-accent">
        Hablemos de tu proyecto
      </a>
      <a href="/trabajos" class="btn btn-ghost">Ver trabajos</a>
    </div>
  </section>

  {/* 2. SOCIAL PROOF (placeholder sectors — swap for real client logos) */}
  <section class="border-y border-border bg-sand/60">
    <div class="container py-8">
      <p class="text-sm text-muted text-center">
        Negocios de Guanacaste que crecen con una presencia digital hecha con raíz
      </p>
      <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3 mt-4 text-ink/70 font-medium">
        {proofSectors.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  {/* 3. EL PROBLEMA */}
  <section class="container py-20">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight max-w-2xl">
      ¿Tu negocio es excelente, pero en internet no se nota?
    </h2>
    <div class="grid gap-8 sm:grid-cols-3 mt-12">
      {
        pains.map((p) => (
          <div>
            <div class="flex items-center justify-center h-11 w-11 rounded-xl bg-sand text-brand">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true" set:html={p.icon} />
            </div>
            <h3 class="text-xl mt-4">{p.title}</h3>
            <p class="text-muted mt-2">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* 4. CASOS DESTACADOS (placeholder cards — the sales engine) */}
  <section class="container py-20 border-t border-border">
    <div class="flex items-end justify-between gap-4 flex-wrap">
      <div>
        <p class="text-brand font-medium">Trabajos</p>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mt-1">
          Negocios que ya dieron el paso
        </h2>
      </div>
      <a href="/trabajos" class="text-brand font-medium hover:text-brand-strong transition-colors">
        Ver todos →
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-10">
      {
        cases.map((c) => (
          <a href="/trabajos" class="card group block rounded-[var(--radius)] border border-border bg-surface overflow-hidden">
            <div class="aspect-[4/3] bg-sand flex items-center justify-center text-muted text-sm font-mono">
              [imagen del proyecto]
            </div>
            <div class="p-5">
              <p class="text-xs uppercase tracking-wide text-brand font-medium">{c.sector}</p>
              <h3 class="text-lg mt-1">{c.title}</h3>
              <p class="text-muted text-sm mt-1">{c.result}</p>
            </div>
          </a>
        ))
      }
    </div>
    <p class="text-muted text-sm font-mono mt-6">[Ejemplos — se reemplazan con tus proyectos reales]</p>
  </section>

  {/* 5. QUÉ HACEMOS */}
  <section class="container py-20 border-t border-border">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">
      Todo lo que tu negocio necesita en línea
    </h2>
    <div class="grid gap-6 sm:grid-cols-3 mt-10">
      {
        offers.map((o) => (
          <div class="card rounded-[var(--radius)] border border-border bg-surface p-6">
            <h3 class="text-xl">{o.name}</h3>
            <p class="text-muted mt-2 text-sm">{o.desc}</p>
          </div>
        ))
      }
    </div>
    <a href="/servicios" class="inline-block mt-8 text-brand font-medium hover:text-brand-strong transition-colors">
      Ver servicios y planes →
    </a>
  </section>

  {/* 6. CÓMO TRABAJAMOS */}
  <section class="container py-20 border-t border-border">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Simple, de principio a fin</h2>
    <div class="grid gap-10 sm:grid-cols-3 mt-12">
      {
        steps.map((s) => (
          <div>
            <span class="font-display text-3xl text-accent">{s.n}</span>
            <h3 class="text-xl mt-3">{s.title}</h3>
            <p class="text-muted mt-2">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* 7. POR QUÉ RAÍZ */}
  <section class="container py-20 border-t border-border">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Por qué Raíz</h2>
    <div class="grid gap-8 sm:grid-cols-3 mt-12">
      {
        whys.map((w) => (
          <div>
            <div class="flex items-center justify-center h-11 w-11 rounded-xl bg-brand/10 text-brand">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true" set:html={w.icon} />
            </div>
            <h3 class="text-xl mt-4">{w.title}</h3>
            <p class="text-muted mt-2">{w.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* 8. CTA FINAL */}
  <section class="container pb-24">
    <div class="rounded-[var(--radius)] bg-brand text-on-brand px-6 py-14 sm:px-12 sm:py-20 text-center">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight max-w-2xl mx-auto" style="color:#fff">
        ¿Listo para que te encuentren y te elijan?
      </h2>
      <p class="mt-4 text-white/80 max-w-lg mx-auto">
        Conversemos sin compromiso sobre la presencia digital de tu negocio.
      </p>
      <a href={whatsappLink} target="_blank" rel="noopener" class="btn btn-accent mt-8">
        Hablemos por WhatsApp
      </a>
    </div>
  </section>
</Base>
