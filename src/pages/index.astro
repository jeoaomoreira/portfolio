---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import HeroMinimal from '@/components/HeroMinimal.astro';
import ContactCard from '@/components/ContactCard.astro';
import Icon from '@/components/Icon.astro';
import { whatsappLink } from '@/site';
import { projects } from '@/projects';
import {
  siJavascript,
  siTypescript,
  siHtml5,
  siCss,
  siReact,
  siNextdotjs,
  siAstro,
  siTailwindcss,
  siVite,
  siVercel,
  siSupabase,
  siPostgresql,
  siFigma,
} from 'simple-icons';

// Home page — section order per docs/company/website-architecture.md §4.
// NOTE: `cases` and `proofSectors` below are PLACEHOLDERS marked for replacement
// with Gerardo's real clients/projects before this page goes public.
// `offers` comes from src/site.ts so /servicios can never drift out of sync
// with this page.
//
// HERO (Direction: "the work is the hero", per design-taste-frontend / service kind):
// the two device mockups are STAND-INS for real client sites — swap them for real
// screenshots of Gerardo's projects before launch. Demo businesses are illustrative.

// The way we work — the three traits behind "El partner que te mereces",
// shown as big numbered steps (lead = emphasized word, rest = the lighter tail).
const pillars = [
  {
    n: '01',
    step: '1',
    lead: 'Curiosidad',
    rest: 'para entender',
    body: 'Preguntamos, investigamos y aprendemos antes de recomendar. Tu contexto importa más que una receta.',
  },
  {
    n: '02',
    step: '2',
    lead: 'Ingenio',
    rest: 'para avanzar',
    body: 'Buscamos soluciones prácticas y costo-eficientes. La tecnología tiene que tener sentido para tu negocio.',
  },
  {
    n: '03',
    step: '3',
    lead: 'Compromiso',
    rest: 'para acompañar',
    body: 'Trabajamos con visión de largo plazo, trato cercano y disposición para resolver, no solo para entregar.',
  },
];

const whys = [
  {
    title: 'Raíces locales',
    tag: 'Guanacaste',
    body: 'Somos de aquí. Te damos la mano en persona, no desde una oficina lejana.',
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    title: 'Oficio moderno',
    tag: 'Diseño',
    body: 'La calidad de diseño de un estudio de ciudad grande, para tu negocio local.',
    icon: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>',
  },
  {
    title: 'Acompañamiento',
    tag: 'Mes a mes',
    body: 'No construimos y nos vamos. Nos quedamos cuidando tu presencia en el tiempo.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>',
  },
];

// Oficio moderno — the tech stack, tossed into the card as a pile of tiles.
const techTiles = [
  ...[
    siJavascript,
    siTypescript,
    siHtml5,
    siCss,
    siReact,
    siNextdotjs,
    siAstro,
    siTailwindcss,
    siVite,
    siVercel,
    siSupabase,
    siPostgresql,
    siFigma,
  ].map((s) => ({ kind: 'icon', title: s.title, path: s.path, hex: s.hex })),
  { kind: 'mono', title: 'AWS', text: 'AWS', hex: 'FF9900' },
  { kind: 'mono', title: 'Adobe Illustrator', text: 'Ai', hex: 'FF7C00' },
];
// Resting position (centre %) + rotation of each tile — a heap resting on the
// floor of the card (pile container is inset 2px), filling it edge to edge.
const techLayout = [
  // bottom row (on the floor)
  { x: 7, y: 91, r: -10 }, { x: 21, y: 90, r: 8 }, { x: 35.5, y: 91, r: -6 }, { x: 50, y: 90, r: 11 }, { x: 64.5, y: 91, r: -7 }, { x: 79, y: 90, r: 9 }, { x: 93, y: 91, r: -12 },
  // middle row
  { x: 13, y: 78, r: 9 }, { x: 28, y: 77, r: -11 }, { x: 43, y: 78, r: 7 }, { x: 58, y: 77, r: -9 }, { x: 73, y: 78, r: 12 }, { x: 88, y: 77, r: -8 },
  // top of the heap
  { x: 36, y: 62, r: -7 }, { x: 64, y: 61, r: 10 },
];

// Acompañamiento — bar heights for the "ongoing activity / monitoring" row.
const monBars = [14, 20, 11, 18, 24, 15, 21, 13, 19, 25, 16, 22];

// Proyectos bento — the first cell is the real featured project. Any further
// real projects fill the two small slots next; whatever is left over falls back
// to a "coming soon" placeholder (so the grid stays full as projects ship).
const featured = projects[0];
const moreProjects = projects.slice(1);
const smallPlaceholders = [
  { tag: 'En proceso', title: 'Nuevo proyecto en camino' },
  { tag: 'Próximamente', title: 'Sitio en construcción' },
];
const smallSlots = [
  ...moreProjects.map((project) => ({ kind: 'project' as const, project })),
  ...smallPlaceholders.map((ph) => ({ kind: 'placeholder' as const, ...ph })),
].slice(0, 2);
const widePlaceholder = { n: '04', tag: 'Próximamente', title: 'Tu negocio aquí' };

// 7.5 Preguntas frecuentes — the objections that stand between an owner and the
// WhatsApp message, in the owner's own order (need → money → time → content →
// fear → care → Google → ownership → renovación). Grounded in the business logic
// in docs/company/foundations.md; wording approved with Gerardo.
const faqs = [
  {
    q: '¿Necesito una página web si ya tengo Facebook e Instagram?',
    a: 'Las redes son prestadas: no controlás el alcance y mañana cambian las reglas. Tu sitio es tuyo, aparece en Google cuando alguien busca tu tipo de negocio en tu zona y trabaja 24/7 dándole credibilidad a tu marca. No reemplazan tu Facebook — lo potencian. Por eso conectamos las dos cosas.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: 'Depende de lo que tu negocio necesite: un sitio nuevo (Lanzamiento) no es lo mismo que renovar uno que ya existe. Siempre son dos partes claras: un pago único por el sitio y, si querés, el Plan nambuku mensual para mantenerlo cuidado. Te damos el precio exacto antes de empezar — sin sorpresas ni letra chica.',
  },
  {
    q: '¿Cómo es el esquema de pago?',
    a: 'El esquema lo definimos en la primera conversación, según el alcance y lo que les sirva a ambas partes. Lo más común es un 30/70 — un adelanto para arrancar y el resto a la entrega — o pagos por etapas. Nos adaptamos a vos, no al revés.',
  },
  {
    q: '¿Cuánto tiempo tarda?',
    a: 'La mayoría de los sitios de negocios locales están listos en pocas semanas, una vez que tenemos tus fotos y textos. Te decimos el plazo desde el primer día y te mantenemos al tanto en cada paso.',
  },
  {
    q: '¿Quién hace los textos y las imágenes de la página?',
    a: 'Si ya tenés textos y fotos, los usamos. Si no, nosotros los creamos: escribimos los textos a partir de una conversación con vos, y conseguimos o generamos las imágenes acordes al diseño. El contenido es parte del proyecto y lo definimos desde el inicio — no lo dejamos para el final.',
  },
  {
    q: '¿Y si no entiendo nada de tecnología?',
    a: 'No necesitás entenderla — para eso estamos nosotros. Te explicamos todo en palabras simples y nos encargamos de la parte técnica. Vos te enfocás en tu negocio.',
  },
  {
    q: '¿Puedo pedir cambios después de que esté en línea?',
    a: 'Claro. Con el Plan nambuku nos encargamos de las actualizaciones, el hosting, la seguridad y los respaldos. ¿Necesitás cambiar un precio, una foto o un horario? Nos mandás un WhatsApp y lo hacemos.',
  },
  {
    q: '¿Van a hacer que mi negocio aparezca en Google?',
    a: 'Es parte central de lo que hacemos: configuramos tu perfil de Google y construimos el sitio para que te encuentren. Con honestidad: posicionarse toma tiempo, no hay magia de la noche a la mañana — pero dejamos la base lista y el Plan nambuku la sigue mejorando.',
  },
  {
    q: '¿Quién es el dueño del sitio y del dominio?',
    a: 'Vos. El dominio y el sitio quedan a nombre de tu negocio, no del nuestro. No te amarramos a nada: si algún día querés seguir por tu cuenta, todo es tuyo.',
  },
  {
    q: 'Ya tengo una página, pero está vieja. ¿Empiezan de cero?',
    a: 'No necesariamente. Eso es una Renovación: tomamos lo que ya tenés y lo modernizamos para que se vea y funcione como tu negocio merece hoy.',
  },
];
---

<Base footerTone="accent">
  <HeroMinimal />

  {/* Everything below the hero rides in one opaque layer that scrolls up over the
      now-fixed hero image, fully covering it. */}
  <div class="scroll-over">
    {/* 2.5 EL PARTNER QUE TE MERECES — how we work, as big numbered steps. */}
    <section class="container section section-divided">
      <div>
        <p class="text-sm font-medium text-accent uppercase tracking-wide">El partner que te mereces</p>
        <h2 class="mt-5 max-w-5xl text-[clamp(3rem,8vw,6rem)] font-bold leading-[0.98] tracking-[-0.035em]">
          Que alguien entienda tu negocio cambia todo<span class="text-accent">.</span>
        </h2>
      </div>

      <div class="steps mt-14">
        {
          pillars.map((p) => (
            <article class="step card-surface">
              <div class="step__num" aria-hidden="true">{p.n}</div>
              <div class="step__body">
                <p class="step__meta">
                  <span>00 · {p.step}</span>
                  <span class="step__meta-line" aria-hidden="true" />
                  <span>Paso</span>
                </p>
                <h3 class="step__title">
                  <strong>{p.lead}</strong> {p.rest}
                </h3>
                <p class="step__desc">{p.body}</p>
              </div>
              <svg
                class="step__arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </article>
          ))
        }
      </div>
    </section>

    {/* 3. PROYECTOS — bento on a full-bleed deep-black section (featured + placeholders) */}
    <section class="section bento-section">
      <div class="container">
        <div class="bento">
        {/* Headline cell */}
        <div class="bento__head">
          <h2 class="bento__title">Proyectos<span class="text-accent">.</span></h2>
          <p class="bento__lead">
            Negocios de Guanacaste que dieron el paso a una presencia digital con nambuku.
          </p>
          <a href="/proyectos" class="bento__all">
            Ver todos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        </div>

        {/* Featured — the real project */}
        <a href={`/proyectos/${featured.slug}`} class="bento__cell bento__feat">
          <Image
            src={featured.cover}
            alt={featured.coverAlt}
            widths={[480, 768, 1000]}
            sizes="(min-width: 1024px) 48vw, 92vw"
            format="webp"
            quality={74}
            loading="lazy"
            decoding="async"
            class="bento__feat-img"
          />
          <div class="bento__feat-info">
            <span class="bento__tag">{featured.sector}</span>
            <h3 class="bento__feat-name">{featured.name}</h3>
            <p class="bento__feat-sum">{featured.summary}</p>
          </div>
          <span class="bento__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
          </span>
        </a>

        {/* Small slots — real projects first, then "coming soon" placeholders */}
        {
          smallSlots.map((slot, i) => {
            const n = String(i + 2).padStart(2, '0'); // 02, 03
            return slot.kind === 'project' ? (
              <a href={`/proyectos/${slot.project.slug}`} class={`bento__cell bento__proj bento__ph--${n}`}>
                <Image
                  src={slot.project.cover}
                  alt={slot.project.coverAlt}
                  widths={[300, 480, 640]}
                  sizes="(min-width: 900px) 23vw, 92vw"
                  format="webp"
                  quality={72}
                  loading="lazy"
                  decoding="async"
                  class="bento__proj-img"
                />
                <div class="bento__proj-info">
                  <span class="bento__tag">{slot.project.sector}</span>
                  <h3 class="bento__proj-name">{slot.project.name}</h3>
                </div>
                <span class="bento__arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
                </span>
              </a>
            ) : (
              <div class={`bento__cell bento__ph bento__ph--${n}`}>
                <span class="bento__num" aria-hidden="true">{n}</span>
                <div class="bento__ph-foot">
                  <span class="bento__tag bento__tag--ghost">{slot.tag}</span>
                  <h3 class="bento__ph-title">{slot.title}</h3>
                </div>
                <span class="bento__arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
                </span>
              </div>
            );
          })
        }

        {/* Wide placeholder */}
        <div class="bento__cell bento__ph bento__ph--wide">
          <span class="bento__num" aria-hidden="true">{widePlaceholder.n}</span>
          <div class="bento__ph-foot">
            <span class="bento__tag bento__tag--ghost">{widePlaceholder.tag}</span>
            <h3 class="bento__ph-title">{widePlaceholder.title}</h3>
          </div>
          <span class="bento__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
          </span>
        </div>

        {/* Accent CTA */}
        <a href="/contacto" class="bento__cell bento__cta">
          <h3 class="bento__cta-title">¿Tu negocio es el próximo?</h3>
          <span class="bento__cta-link">
            Hablemos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
        </div>
      </div>
    </section>

    {/* 7. POR QUÉ RAÍZ — bento on a full-bleed deep-black section */}
    <section class="section why-section">
      <div class="container">
        <div class="why">
          <div class="why__head">
            <p class="kicker">Por qué nambuku</p>
            <h2 class="why__title">Cerca, moderno y para el largo plazo<span class="text-accent">.</span></h2>
          </div>

          <div class="why__grid">
            {
              whys.map((w, i) => (
                <article class:list={['why__item', i === 1 && 'why__item--mid']}>
                  {i === 1 && (
                    <a href="/nosotros" class="why__bar">
                      Conócenos
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                    </a>
                  )}
                  <div class="why__card">
                    {
                      i === 0 ? (
                        <svg
                          class="why__map"
                          viewBox="0 0 240 200"
                          preserveAspectRatio="xMidYMid meet"
                          aria-hidden="true"
                        >
                          <defs>
                            <pattern id="whyDots" width="13" height="13" patternUnits="userSpaceOnUse">
                              <circle cx="1.5" cy="1.5" r="1.1" class="map-dot" />
                            </pattern>
                          </defs>
                          <rect x="0" y="0" width="240" height="200" fill="url(#whyDots)" />
                          <path
                            class="map-land"
