---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import HeroMinimal from '@/components/HeroMinimal.astro';
import ContactCard from '@/components/ContactCard.astro';
import Icon from '@/components/Icon.astro';
import { whatsappLink } from '@/site';
import { projects } from '@/projects';
import {
  siJavascript,
  siTypescript,
  siHtml5,
  siCss,
  siReact,
  siNextdotjs,
  siAstro,
  siTailwindcss,
  siVite,
  siVercel,
  siSupabase,
  siPostgresql,
  siFigma,
} from 'simple-icons';

// Home page — section order per docs/company/website-architecture.md §4.
// NOTE: `cases` and `proofSectors` below are PLACEHOLDERS marked for replacement
// with Gerardo's real clients/projects before this page goes public.
// `offers` comes from src/site.ts so /servicios can never drift out of sync
// with this page.
//
// HERO (Direction: "the work is the hero", per design-taste-frontend / service kind):
// the two device mockups are STAND-INS for real client sites — swap them for real
// screenshots of Gerardo's projects before launch. Demo businesses are illustrative.

// The way we work — the three traits behind "El partner que te mereces",
// shown as big numbered steps (lead = emphasized word, rest = the lighter tail).
const pillars = [
  {
    n: '01',
    step: '1',
    lead: 'Curiosidad',
    rest: 'para entender',
    body: 'Preguntamos, investigamos y aprendemos antes de recomendar. Tu contexto importa más que una receta.',
  },
  {
    n: '02',
    step: '2',
    lead: 'Ingenio',
    rest: 'para avanzar',
    body: 'Buscamos soluciones prácticas y costo-eficientes. La tecnología tiene que tener sentido para tu negocio.',
  },
  {
    n: '03',
    step: '3',
    lead: 'Compromiso',
    rest: 'para acompañar',
    body: 'Trabajamos con visión de largo plazo, trato cercano y disposición para resolver, no solo para entregar.',
  },
];

const whys = [
  {
    title: 'Raíces locales',
    tag: 'Guanacaste',
    body: 'Somos de aquí. Te damos la mano en persona, no desde una oficina lejana.',
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    title: 'Oficio moderno',
    tag: 'Diseño',
    body: 'La calidad de diseño de un estudio de ciudad grande, para tu negocio local.',
    icon: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>',
  },
  {
    title: 'Acompañamiento',
    tag: 'Mes a mes',
    body: 'No construimos y nos vamos. Nos quedamos cuidando tu presencia en el tiempo.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>',
  },
];

// Oficio moderno — the tech stack, tossed into the card as a pile of tiles.
const techTiles = [
  ...[
    siJavascript,
    siTypescript,
    siHtml5,
    siCss,
    siReact,
    siNextdotjs,
    siAstro,
    siTailwindcss,
    siVite,
    siVercel,
    siSupabase,
    siPostgresql,
    siFigma,
  ].map((s) => ({ kind: 'icon', title: s.title, path: s.path, hex: s.hex })),
  { kind: 'mono', title: 'AWS', text: 'AWS', hex: 'FF9900' },
  { kind: 'mono', title: 'Adobe Illustrator', text: 'Ai', hex: 'FF7C00' },
];
// Resting position (centre %) + rotation of each tile — a heap resting on the
// floor of the card (pile container is inset 2px), filling it edge to edge.
const techLayout = [
  // bottom row (on the floor)
  { x: 7, y: 91, r: -10 }, { x: 21, y: 90, r: 8 }, { x: 35.5, y: 91, r: -6 }, { x: 50, y: 90, r: 11 }, { x: 64.5, y: 91, r: -7 }, { x: 79, y: 90, r: 9 }, { x: 93, y: 91, r: -12 },
  // middle row
  { x: 13, y: 78, r: 9 }, { x: 28, y: 77, r: -11 }, { x: 43, y: 78, r: 7 }, { x: 58, y: 77, r: -9 }, { x: 73, y: 78, r: 12 }, { x: 88, y: 77, r: -8 },
  // top of the heap
  { x: 36, y: 62, r: -7 }, { x: 64, y: 61, r: 10 },
];

// Acompañamiento — bar heights for the "ongoing activity / monitoring" row.
const monBars = [14, 20, 11, 18, 24, 15, 21, 13, 19, 25, 16, 22];

// Proyectos bento — the first cell is the real featured project; the rest are
// placeholders for the next 2–3 projects (swap each for a real one as it ships).
const featured = projects[0];
const placeholders = [
  { n: '02', tag: 'En proceso', title: 'Nuevo proyecto en camino' },
  { n: '03', tag: 'Próximamente', title: 'Sitio en construcción' },
  { n: '04', tag: 'Próximamente', title: 'Tu negocio aquí' },
];
---

<Base footerTone="accent">
  <HeroMinimal />

  {/* Everything below the hero rides in one opaque layer that scrolls up over the
      now-fixed hero image, fully covering it. */}
  <div class="scroll-over">
    {/* 2.5 EL PARTNER QUE TE MERECES — how we work, as big numbered steps. */}
    <section class="container section section-divided">
      <div>
        <p class="text-sm font-medium text-accent uppercase tracking-wide">El partner que te mereces</p>
        <h2 class="mt-5 max-w-5xl text-[clamp(3rem,8vw,6rem)] font-bold leading-[0.98] tracking-[-0.035em]">
          Que alguien entienda tu negocio cambia todo<span class="text-accent">.</span>
        </h2>
      </div>

      <div class="steps mt-14">
        {
          pillars.map((p) => (
            <article class="step card-surface">
              <div class="step__num" aria-hidden="true">{p.n}</div>
              <div class="step__body">
                <p class="step__meta">
                  <span>00 · {p.step}</span>
                  <span class="step__meta-line" aria-hidden="true" />
                  <span>Paso</span>
                </p>
                <h3 class="step__title">
                  <strong>{p.lead}</strong> {p.rest}
                </h3>
                <p class="step__desc">{p.body}</p>
              </div>
              <svg
                class="step__arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </article>
          ))
        }
      </div>
    </section>

    {/* 3. PROYECTOS — bento on a full-bleed deep-black section (featured + placeholders) */}
    <section class="section bento-section">
      <div class="container">
        <div class="bento">
        {/* Headline cell */}
        <div class="bento__head">
          <h2 class="bento__title">Proyectos<span class="text-accent">.</span></h2>
          <p class="bento__lead">
            Negocios de Guanacaste que dieron el paso a una presencia digital con raız.
          </p>
          <a href="/proyectos" class="bento__all">
            Ver todos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        </div>

        {/* Featured — the real project */}
        <a href={`/proyectos/${featured.slug}`} class="bento__cell bento__feat">
          <Image
            src={featured.cover}
            alt={featured.coverAlt}
            widths={[480, 768, 1000]}
            sizes="(min-width: 1024px) 48vw, 92vw"
            format="webp"
            quality={74}
            loading="lazy"
            decoding="async"
            class="bento__feat-img"
          />
          <div class="bento__feat-info">
            <span class="bento__tag">{featured.sector}</span>
            <h3 class="bento__feat-name">{featured.name}</h3>
            <p class="bento__feat-sum">{featured.summary}</p>
          </div>
          <span class="bento__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
          </span>
        </a>

        {/* Placeholder project slots (swap each for a real project as it ships) */}
        {
          placeholders.slice(0, 2).map((p) => (
            <div class={`bento__cell bento__ph bento__ph--${p.n}`}>
              <span class="bento__num" aria-hidden="true">{p.n}</span>
              <div class="bento__ph-foot">
                <span class="bento__tag bento__tag--ghost">{p.tag}</span>
                <h3 class="bento__ph-title">{p.title}</h3>
              </div>
              <span class="bento__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
              </span>
            </div>
          ))
        }

        {/* Wide placeholder */}
        <div class="bento__cell bento__ph bento__ph--wide">
          <span class="bento__num" aria-hidden="true">{placeholders[2].n}</span>
          <div class="bento__ph-foot">
            <span class="bento__tag bento__tag--ghost">{placeholders[2].tag}</span>
            <h3 class="bento__ph-title">{placeholders[2].title}</h3>
          </div>
          <span class="bento__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
          </span>
        </div>

        {/* Accent CTA */}
        <a href="/contacto" class="bento__cell bento__cta">
          <h3 class="bento__cta-title">¿Tu negocio es el próximo?</h3>
          <span class="bento__cta-link">
            Hablemos
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
        </div>
      </div>
    </section>

    {/* 7. POR QUÉ RAÍZ — bento on a full-bleed deep-black section */}
    <section class="section why-section">
      <div class="container">
        <div class="why">
          <div class="why__head">
            <p class="kicker">Por qué raız</p>
            <h2 class="why__title">Cerca, moderno y para el largo plazo<span class="text-accent">.</span></h2>
          </div>

          <div class="why__grid">
            {
              whys.map((w, i) => (
                <article class:list={['why__item', i === 1 && 'why__item--mid']}>
                  {i === 1 && (
                    <a href="/nosotros" class="why__bar">
                      Conócenos
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                    </a>
                  )}
                  <div class="why__card">
                    {
                      i === 0 ? (
                        <svg
                          class="why__map"
                          viewBox="0 0 240 200"
                          preserveAspectRatio="xMidYMid meet"
                          aria-hidden="true"
                        >
                          <defs>
                            <pattern id="whyDots" width="13" height="13" patternUnits="userSpaceOnUse">
                              <circle cx="1.5" cy="1.5" r="1.1" class="map-dot" />
                            </pattern>
                          </defs>
                          <rect x="0" y="0" width="240" height="200" fill="url(#whyDots)" />
                          <path
                            class="map-land"
                            d="M130.5 190.7 C129.4 190.0 128.4 188.6 128.3 187.8 C128.2 186.0 124.0 182.2 122.2 182.2 C121.6 182.2 120.9 181.8 120.7 181.2 C120.2 180.0 113.9 177.1 112.7 177.6 C112.1 177.8 110.7 177.5 109.5 176.9 C107.9 176.0 107.2 176.0 106.4 176.6 C105.4 177.4 102.6 176.9 102.6 175.9 C102.6 175.5 101.9 175.4 101.2 175.6 C100.4 175.8 99.8 175.7 99.8 175.3 C99.8 174.9 97.9 174.4 95.7 174.2 C89.2 173.5 86.8 173.0 85.9 171.8 C85.4 171.3 84.3 170.9 83.4 171.0 C82.2 171.2 81.8 171.0 82.0 170.1 C82.3 168.0 79.5 162.9 75.9 158.7 C73.9 156.5 72.3 154.3 72.3 153.9 C72.3 153.5 71.2 151.9 69.9 150.4 C68.6 148.9 67.1 145.9 66.3 143.5 C65.7 141.2 64.4 138.1 63.7 136.6 C61.1 131.9 59.5 122.8 61.0 121.9 C62.2 121.1 61.7 119.0 59.9 117.0 C57.9 114.9 57.7 113.8 59.2 113.8 C59.7 113.8 60.9 112.6 61.7 111.1 C62.8 109.0 63.6 108.4 64.6 108.7 C66.0 109.0 67.4 106.5 66.8 104.7 C66.5 104.0 66.7 103.9 67.3 104.2 C67.8 104.6 68.4 104.4 68.7 103.9 C69.3 102.9 68.2 99.0 67.3 99.0 C67.0 99.0 66.6 98.2 66.4 97.2 C66.2 95.9 66.6 94.8 67.7 93.6 C69.1 92.1 69.5 92.0 70.7 92.7 C71.9 93.4 72.4 93.3 74.5 91.7 C75.9 90.7 77.2 90.0 77.4 90.3 C77.7 90.5 78.1 90.1 78.4 89.4 C79.0 87.6 81.2 85.6 82.4 85.6 C83.5 85.6 86.4 82.0 86.4 80.8 C86.4 80.1 84.7 79.2 83.4 79.2 C83.1 79.2 81.8 80.3 80.6 81.5 C79.4 82.8 78.6 83.5 78.7 83.1 C78.9 82.7 79.6 81.2 80.3 79.8 C80.9 78.3 82.0 76.9 82.6 76.5 C83.5 76.0 83.6 75.4 82.9 72.0 C82.4 69.9 82.3 67.3 82.5 66.4 C82.8 65.2 82.4 63.8 81.3 62.1 C79.9 60.0 79.0 59.4 75.9 58.8 C73.4 58.2 71.9 58.2 71.4 58.7 C70.4 59.6 66.9 58.3 66.3 56.8 C66.0 56.2 66.2 55.5 66.6 55.4 C68.4 54.8 67.0 53.9 63.4 53.5 C60.9 53.1 59.6 52.6 59.6 52.0 C59.6 51.5 58.0 50.4 56.0 49.5 C54.1 48.7 52.5 47.8 52.5 47.5 C52.5 47.2 54.0 46.4 55.7 45.7 C58.3 44.8 58.9 44.2 58.6 43.1 C58.3 41.9 58.6 41.8 61.2 42.0 C63.5 42.2 64.2 42.5 64.4 43.6 C64.8 46.0 68.0 47.2 67.8 44.9 C67.7 43.9 68.3 43.6 71.1 43.4 C73.3 43.3 74.8 43.5 75.1 44.0 C75.5 44.7 76.0 44.6 76.9 43.7 C77.9 42.7 77.9 42.3 77.2 41.9 C76.5 41.4 76.6 41.1 77.8 40.3 C80.3 38.8 79.9 38.1 72.6 33.1 C71.2 32.1 71.2 32.1 72.9 30.5 C74.4 29.0 74.6 29.0 75.4 30.1 C76.3 31.3 78.3 31.6 80.3 30.8 C81.9 30.2 81.7 27.3 79.9 26.1 C78.5 25.1 78.5 25.0 83.2 16.7 C85.9 12.1 88.1 8.3 88.2 8.1 C88.3 8.0 89.8 8.1 91.5 8.4 C94.2 8.8 95.0 9.3 96.8 11.8 C98.6 14.3 99.8 15.0 105.1 17.0 C108.7 18.3 112.7 19.3 114.5 19.3 C116.9 19.3 119.4 20.2 124.7 22.9 C128.7 24.9 132.1 26.8 132.5 27.1 C132.8 27.4 132.0 28.1 130.6 28.7 C129.2 29.3 127.2 31.1 125.8 32.9 C124.2 35.3 122.4 36.7 119.5 38.0 C116.5 39.4 115.2 40.5 114.3 42.3 C113.3 44.5 112.9 44.7 111.1 44.3 C107.7 43.6 107.9 45.2 112.1 50.3 C115.3 54.3 116.5 55.3 118.6 55.7 C122.7 56.4 123.5 57.1 124.8 60.8 C125.4 62.7 126.4 64.5 127.1 64.7 C127.7 65.0 130.7 64.8 133.7 64.3 C139.0 63.5 139.4 63.5 141.4 65.0 C142.5 65.8 144.4 67.2 145.4 67.9 C146.5 68.7 149.1 69.7 151.2 70.1 C153.3 70.5 155.7 71.2 156.6 71.8 C158.5 73.0 161.1 78.0 161.1 80.3 C161.1 81.4 162.4 83.3 164.9 85.9 C168.2 89.2 169.1 89.8 171.3 89.8 C172.7 89.8 174.7 90.4 175.8 91.0 C179.6 93.4 185.1 98.5 185.1 99.6 C185.1 100.2 185.6 101.4 186.2 102.1 C187.5 103.8 187.5 105.9 186.2 108.9 C185.5 110.6 185.5 111.7 186.0 113.5 C186.5 115.2 186.5 116.4 185.9 117.7 C185.1 119.5 185.0 119.5 183.8 118.5 C181.9 116.8 180.4 117.0 177.3 119.5 C174.5 121.8 173.9 123.4 175.2 124.8 C175.7 125.3 175.6 126.7 175.0 129.0 C174.3 131.6 174.3 133.1 174.8 134.2 C175.3 135.5 175.3 136.0 174.7 136.2 C174.3 136.3 172.8 137.2 171.6 138.0 C169.6 139.3 169.2 140.1 169.2 142.2 C169.2 143.6 169.0 144.8 168.6 144.8 C168.3 144.8 166.9 143.7 165.7 142.3 C163.6 140.0 162.6 139.6 158.4 138.8 C155.5 138.3 153.0 138.3 152.4 138.6 C151.7 139.0 150.3 138.8 148.7 138.1 C145.6 136.8 145.9 136.8 144.7 138.1 C143.9 138.9 143.1 138.9 139.7 138.1 C134.7 137.0 132.9 135.5 132.9 132.5 C132.9 129.8 131.4 127.5 128.7 126.1 C127.5 125.5 126.7 124.7 126.9 124.2 C127.1 123.7 126.3 122.3 125.1 121.0 C123.4 119.1 122.5 118.7 120.2 118.7 C118.3 118.7 117.5 11