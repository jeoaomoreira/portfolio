---
import Base from '@/layouts/Base.astro';
import { offers } from '@/site';
---

<Base
  title="Servicios"
  description="Lanzamiento, Renovación y Plan nambuku — presencia digital completa para tu negocio."
>
  <section class="container section">
    <h1 class="page-title">Servicios<span class="text-accent">.</span></h1>
    <p class="text-muted mt-5 max-w-xl text-lg">
      Todo lo que tu negocio necesita para que lo encuentren, confíen en él y lo elijan.
    </p>

    <div class="mt-14 flex flex-col gap-5">
      {
        offers.map((o, i) => (
          <div class="card card-surface grid gap-x-8 gap-y-2 p-7 md:grid-cols-[auto_1fr_minmax(0,32rem)] md:items-baseline">
            <span class="font-mono text-sm text-accent">0{i + 1}</span>
            <h2 class="text-2xl font-semibold tracking-tight">{o.name}</h2>
            <p class="text-muted">{o.desc}</p>
          </div>
        ))
      }
    </div>
    <p class="text-muted mt-10 text-sm font-mono">[Precios — pendiente documento de precios]</p>
  </section>
</Base>
