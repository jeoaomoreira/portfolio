---
import Base from '@/layouts/Base.astro';
import { offers } from '@/site';
---

<Base
  title="Servicios"
  description="Lanzamiento, Renovación y Plan Raíz — presencia digital completa para tu negocio."
>
  <section class="container section">
    <h1 class="page-title">Servicios</h1>
    <p class="text-muted mt-3 max-w-xl">
      Todo lo que tu negocio necesita para que lo encuentren, confíen en él y lo elijan.
    </p>

    <div class="grid gap-6 sm:grid-cols-3 mt-12">
      {
        offers.map((o) => (
          <div class="card card-surface p-6">
            <h2 class="text-xl">{o.name}</h2>
            <p class="text-muted mt-2 text-sm">{o.desc}</p>
          </div>
        ))
      }
    </div>
    <p class="text-muted mt-10 text-sm font-mono">[Precios — pendiente documento de precios]</p>
  </section>
</Base>
